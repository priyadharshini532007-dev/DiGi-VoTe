# DIGI-VOTE backend configuration. Copy to .env (git-ignored) and fill in. Placeholders only.
# scripts/dev-mysql.sh writes the DB_* values for the local development database automatically.

# --- Database (MySQL 8+) ---
DB_URL=jdbc:mysql://127.0.0.1:3307/digivote
DB_USERNAME=digivote
DB_PASSWORD=change-me
# Integration tests clean and re-migrate this database. Never point it at real data.
TEST_DB_URL=jdbc:mysql://127.0.0.1:3307/digivote_test

# --- Security ---
# Dev mode generates local secrets in .local/ when the two keys below are empty. Set false in production.
DIGIVOTE_DEV_MODE=true
# HS256 session signing secret, at least 32 bytes (e.g. `openssl rand -base64 48`).
DIGIVOTE_JWT_SECRET=
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts election private keys. Back it up:
# losing it makes tallying elections with existing keys impossible.
DIGIVOTE_MASTER_KEY=
DIGIVOTE_JWT_TTL_MINUTES=120

# --- Web ---
PORT=8080
DIGIVOTE_PUBLIC_BASE_URL=http://localhost:8080
DIGIVOTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cryptography (defaults are production sizes) ---
DIGIVOTE_RSA_BITS=2048
DIGIVOTE_PAILLIER_BITS=2048

# --- Storage: local (./.local/media) or firebase ---
DIGIVOTE_STORAGE_PROVIDER=local

# --- Firebase (optional). Service-account JSON stays outside the repository. ---
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
FIREBASE_APP_CHECK_ENABLED=false
# Local testing only: verify tokens from the Firebase Auth emulator (never set in production)
FIREBASE_AUTH_EMULATOR_HOST=

# --- Voter self sign-up ---
# Slug of the organization that the Sign up page adds people to (as Voter or Candidate). Empty = sign-up disabled.
DIGIVOTE_SIGNUP_ORG_SLUG=
